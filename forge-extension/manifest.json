{
  "manifest_version": 3,
  "name": "FORGE Prospect Capture",
  "version": "0.1.0",
  "description": "Capture sponsor prospects from LinkedIn and the web into your FORGE repo.",
  "permissions": ["activeTab", "scripting", "storage", "clipboardWrite"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/company/*",
        "https://www.linkedin.com/in/*"
      ],
      "js": ["src/linkedin-extractor.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
